{
  "version": 2,
  "axioms": {
    "linguist": "language",
    "licensee": "license",
    "packagers": "packager"
  },
  "rules": {
    "license-file-exists": {
      "level": "error",
      "rule": {
        "type": "file-existence",
        "options": {
          "globsAny": ["LICENSE*", "COPYING*"],
          "nocase": true
        }
      }
    },
    "source-license-headers-exist": {
      "level": "warning",
      "rule": {
        "type": "file-starts-with",
        "options": {
          "globsAll": [
            "**/*.py",
            "**/*.js",
            "**/*.java",
            "**/*.sh"
          ],
          "skip-paths-matching": {
            "patterns": [
              "node_modules/**",
              "venv/**",
              "spa-app/node_modules/**",
              "spa-app/build/**",
              "spring-app/target/**",
              "**/.git/**",
              "**/cdk.out/**"
            ]
          },
          "lineCount": 5,
          "patterns": ["Copyright", "License"],
          "flags": "i"
        }
      }
    }
  }
}
